# Server-only local demo configuration. Do not use EXPO_PUBLIC_ for provider keys.
OPENAI_API_KEY=
NURA_MODEL=gpt-5.6-luna
# Optional older alias. NURA_MODEL takes precedence.
OPENAI_MODEL=
NURA_LLM_PROVIDER=openai
NURA_AGENT_PORT=4175
NURA_BIND_HOST=127.0.0.1
NURA_ENABLE_DEMO_INTAKE=true
NURA_MAX_INTAKE_BYTES=15728640
NURA_DEMO_DATA_DIR=./server/.nura-dev
# Web search is off unless both flags are explicitly enabled and each run opts in.
NURA_HEALTH_SEARCH_ENABLED=false
NURA_ENABLE_DEMO_WEB_SEARCH=false
